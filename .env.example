# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# AWS Bedrock (scripts/run_text.py). IAM user keys from Nasir; region is fixed to us-east-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# tau2 needs its domain data on disk (not shipped in the pip package).
# Relative to the repo root; run commands from there.
TAU2_DATA_DIR=third_party/tau2-bench/data
